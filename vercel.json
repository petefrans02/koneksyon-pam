{
  "headers": [
    {
      "source": "/otc.ics",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline; filename=\"trading-otc.ics\"" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/contests",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-post",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/generate-lesson",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/generate-quiz",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/generate-discussions",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/trading-center",
      "schedule": "0 */2 * * *"
    }
  ]
}
